    <!-- ========== JAVASCRIPT (all logic, using event listeners) ========== -->
    <script>
        (function() {
            // Wait for DOM to be fully loaded before attaching listeners
            document.addEventListener('DOMContentLoaded', function() {
                
                // -------------------- COIN MODULE --------------------
                const coinModule = {
                    // state
                    total: 0,
                    heads: 0,
                    tails: 0,
                    // DOM elements
                    coinElement: document.getElementById('coin3d'),
                    wrapperElement: document.getElementById('coinWrapper'),
                    flipBtn: document.getElementById('flipBtn'),
                    resetBtn: document.getElementById('resetStatsBtn'),
                    historyContainer: document.getElementById('historyContainer'),
                    // animation guard
                    animating: false,
                    // cumulative rotation (spins accumulate)
                    currentRotation: 0,

                    // Update the stats display
                    updateStatsUI: function() {
                        document.getElementById('statTotal').innerText = this.total;
                        document.getElementById('statHeads').innerText = this.heads;
                        document.getElementById('statTails').innerText = this.tails;
                    },

                    // Add a new entry to history with timestamp
                    addHistory: function(result) {
                        const entry = document.createElement('div');
                        entry.className = 'history-entry';
                        const now = new Date();
                        const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                        entry.innerHTML = `<span>${result}</span> <span style="color:#b7c9dd;">${timeStr}</span>`;
                        this.historyContainer.prepend(entry);
                        // Keep only last 12 entries to avoid clutter
                        if (this.historyContainer.children.length > 12) {
                            this.historyContainer.removeChild(this.historyContainer.lastElementChild);
                        }
                    },

                    // Main flip logic
                    flip: function() {
                        if (this.animating) return; // prevent double flip

                        this.animating = true;
                        this.flipBtn.disabled = true;   // disable button during animation

                        // Trigger flying animation on wrapper
                        this.wrapperElement.classList.add('fly');

                        // Random outcome
                        const isHeads = Math.random() < 0.5;
                        const result = isHeads ? 'HEADS' : 'TAILS';
                        
                        // Add spin: 8 full turns for heads, 8.5 for tails (so final face is correct)
                        const spin = isHeads ? 2880 : 3060;
                        this.currentRotation += spin;
                        
                        // Apply rotation to coin
                        this.coinElement.style.transform = `rotateY(${this.currentRotation}deg)`;

                        // After animation completes, update stats and clean up
                        setTimeout(() => {
                            this.total++;
                            if (isHeads) {
                                this.heads++;
                            } else {
                                this.tails++;
                            }
                            this.updateStatsUI();
                            this.addHistory(result);

                            // Remove flying class and re-enable button
                            this.wrapperElement.classList.remove('fly');
                            this.animating = false;
                            this.flipBtn.disabled = false;
                        }, 900); // matches animation duration (0.9s)
                    },

                    // Reset statistics and clear history
                    resetStats: function() {
                        if (this.animating) return; // don't reset while flipping
                        this.total = 0;
                        this.heads = 0;
                        this.tails = 0;
                        this.updateStatsUI();
                        // Clear history
                        this.historyContainer.innerHTML = '';
                        // Show a temporary placeholder
                        const placeholder = document.createElement('div');
                        placeholder.className = 'history-entry';
                        placeholder.style.justifyContent = 'center';
                        placeholder.style.opacity = '0.5';
                        placeholder.innerText = '✨ history cleared';
                        this.historyContainer.appendChild(placeholder);
                        setTimeout(() => { 
                            if (this.historyContainer.firstChild === placeholder) 
                                placeholder.remove(); 
                        }, 1500);
                    }
                };

                // -------------------- TIMER MODULE --------------------
                const timerModule = {
                    seconds: 0,
                    intervalId: null,
                    running: false,
                    laps: [],
                    // DOM elements
                    displayElem: document.getElementById('timerDisplay'),
                    lapContainer: document.getElementById('lapListContainer'),
                    stateIndicator: document.getElementById('timerStateIndicator'),
                    startBtn: document.getElementById('startTimerBtn'),
                    pauseBtn: document.getElementById('pauseTimerBtn'),
                    lapBtn: document.getElementById('lapTimerBtn'),
                    resetBtn: document.getElementById('resetTimerBtn'),

                    // Format seconds as MM:SS
                    formatTime: function(totalSec) {
                        const mins = Math.floor(totalSec / 60);
                        const secs = totalSec % 60;
                        return `${mins < 10 ? '0' : ''}${mins}:${secs < 10 ? '0' : ''}${secs}`;
                    },

                    // Update the timer display
                    updateDisplay: function() {
                        this.displayElem.innerText = this.formatTime(this.seconds);
                    },

                    // Render lap list
                    renderLaps: function() {
                        if (this.laps.length === 0) {
                            this.lapContainer.innerHTML = '<div class="lap-item" style="justify-content:center; opacity:0.6;">— no laps —</div>';
                            return;
                        }
                        let html = '';
                        this.laps.forEach((lapTime, idx) => {
                            html += `<div class="lap-item"><span>Lap ${idx+1}</span><span>${this.formatTime(lapTime)}</span></div>`;
                        });
                        this.lapContainer.innerHTML = html;
                    },

                    // Start timer
                    start: function() {
                        if (this.running) return;
                        this.running = true;
                        this.stateIndicator.innerHTML = '▶ Running';
                        this.intervalId = setInterval(() => {
                            this.seconds++;
                            this.updateDisplay();
                        }, 1000);
                    },

                    // Pause timer
                    pause: function() {
                        if (!this.running) return;
                        clearInterval(this.intervalId);
                        this.intervalId = null;
                        this.running = false;
                        this.stateIndicator.innerHTML = '⏸️ Paused';
                    },

                    // Reset timer (stop, zero, clear laps)
                    reset: function() {
                        clearInterval(this.intervalId);
                        this.intervalId = null;
                        this.running = false;
                        this.seconds = 0;
                        this.laps = [];
                        this.updateDisplay();
                        this.renderLaps();
                        this.stateIndicator.innerHTML = '⏹️ Stopped';
                    },

                    // Record a lap
                    lap: function() {
                        if (!this.running) return; // only record laps when timer is running
                        this.laps.push(this.seconds);
                        this.renderLaps();
                    }
                };

                // ----- Attach event listeners (no onclick in HTML) -----
                coinModule.flipBtn.addEventListener('click', coinModule.flip.bind(coinModule));
                coinModule.resetBtn.addEventListener('click', coinModule.resetStats.bind(coinModule));

                timerModule.startBtn.addEventListener('click', timerModule.start.bind(timerModule));
                timerModule.pauseBtn.addEventListener('click', timerModule.pause.bind(timerModule));
                timerModule.lapBtn.addEventListener('click', timerModule.lap.bind(timerModule));
                timerModule.resetBtn.addEventListener('click', timerModule.reset.bind(timerModule));

                // Initial UI updates
                coinModule.updateStatsUI();
                timerModule.updateDisplay();

                // Add a friendly placeholder in history if empty
                if (coinModule.historyContainer.children.length === 0) {
                    let placeholder = document.createElement('div');
                    placeholder.className = 'history-entry';
                    placeholder.style.justifyContent = 'center';
                    placeholder.style.opacity = '0.5';
                    placeholder.innerText = '⬆️ flip to start';
                    coinModule.historyContainer.appendChild(placeholder);
                }

                // Expose modules globally (optional, for debugging)
                window.coinFlip = coinModule;
                window.timerControl = timerModule;
            });
        })();
    </script>

